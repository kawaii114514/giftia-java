# ================================================================
# 默认 Java / Spring Boot 后端配置
# 复制为根目录 .env 后填写；已有 .env 请保留，不要覆盖真实密钥。
# Java 启动时读取 .env，不需要修改 backend/model_config.py。
# ================================================================

# 对话模型与 OpenAI 兼容接口，修改后重启 Java 后端
CHAT_MODEL=deepseek-v4-flash
CHAT_BASE_URL=https://api.deepseek.com/v1
# CHAT_API_KEY=your_chat_api_key_here
# auto 沿用原模型能力目录；自定义模型可明确设置 true 或 false
# CHAT_MULTIMODAL=auto
# 默认对支持的 DeepSeek / GLM / Qwen 启用思考，分析与记忆任务仍关闭思考
# CHAT_THINKING_ENABLED=true

# 会话模型提供商密钥：填写当前 CHAT_BASE_URL 对应的一项即可
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 向量模型独立于对话模型，默认使用硅基流动 BAAI/bge-m3
EMBED_MODEL=BAAI/bge-m3
EMBED_BASE_URL=https://api.siliconflow.cn/v1/embeddings
# 此密钥优先；留空时尝试 SILICONFLOW_API_KEY（或所配置向量接口的提供商密钥）
EMBEDDING_API_KEY=your_embedding_api_key_here

# ================================================================
# 访问认证（可选，不配置则不需要认证）
# ================================================================

# 访问密钥 — 配置后前端需输入此密钥才能使用
# GIFTIA_ACCESS_KEY=your-secret-key

# 管理员密钥 — 日志、指标和旧版全局人设写接口使用 X-Admin-Key
# 未单独配置时回退到 GIFTIA_ACCESS_KEY 的值，请求头仍为 X-Admin-Key
# GIFTIA_ADMIN_KEY=your-admin-key

# ================================================================
# CORS 跨域配置（可选）
#   默认允许 localhost:3000 与 127.0.0.1:3000，多个源用逗号分隔
# ================================================================
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 可选：指定已有数据库的绝对路径。默认继续使用 backend/giftia.db。
# GIFTIA_DATABASE=D:/MyProject/giftia/backend/giftia.db

# 手动运行 java -jar 时可覆盖监听地址/端口。
# 一键启动脚本固定使用 127.0.0.1:8000，以匹配现有前端代理。
# HOST=127.0.0.1
# PORT=8000
